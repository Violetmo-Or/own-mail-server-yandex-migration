# Скопируйте в config.env (права 600: chmod 600 config.env). Файл НЕ класть в git.

# Откуда копируем (старый почтовый сервер)
SRC_HOST=imap.yandex.ru
SRC_PORT=993

# Куда копируем (ваш новый сервер)
DST_HOST=mail.example.ru
DST_PORT=993

# Хранить только текст писем, а вложения заменять пометкой (экономит диск в 10-20 раз): yes / no
STRIP_ATTACHMENTS=no

# Папки, куда письма НЕ копируем, а только создаём пустыми (через запятую; можно оставить пустым)
WORKFLOW_FOLDERS=

# Команда тревоги: получает текст первым аргументом (например, ваш скрипт отправки в Telegram). Можно пусто.
ALARM_CMD=

# Пароли. ЛОГИН = часть адреса до @ заглавными, дефис заменён на _ (info@example.ru -> INFO)
# Старый ящик (у Яндекса это ПАРОЛЬ ПРИЛОЖЕНИЯ, не основной пароль):
MAIL_INFO_PASS=
# Новый ящик:
MAIL_NEW_INFO_PASS=

# Для поиска и адресной книги (Roundcube)
DOMAIN=example.ru
MAILDIR_BASE=/var/vmail/example.ru
MAILDIR_SUBDIR=Maildir
RC_DB=roundcube

# Сколько дней назад смотреть при первом запуске sync.py (должно перекрывать время после migrate.py)
SYNC_INITIAL_DAYS=7

# Необязательные настройки (уберите «#» в начале строки, если нужно). Комментарии пишите на отдельных строках.
# Если в пароле есть пробел или знак «#», возьмите пароль в кавычки.

# sync.py: также синхронизировать Спам и Корзину (yes)
# INCLUDE_JUNK=yes

# Куда записывать письма, которые не удалось перенести
# UNAVAIL_FILE=/opt/mailmove/unavailable.tsv

# Состояние досинхронизации
# SYNC_DB=/opt/mailmove/sync.db

# Индекс поиска (содержит текст всей переписки; права только владельцу)
# SEARCH_DB=/opt/mailmove/mail-search.db

# contacts.py: должен совпадать с imap_host в конфиге Roundcube
# RC_MAIL_HOST=localhost
